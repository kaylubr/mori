model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  passwordHash String?
  googleId     String?      @unique
  githubId     String?      @unique
  username     String       @unique
  avatarUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  manhwas    Manhwa[]
  reviews    Review[]
  shelfEntry ShelfEntry[]
  reports    Report[]
}