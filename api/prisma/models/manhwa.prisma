model Manhwa {
  id                  Int          @id @default(autoincrement())
  title               String
  description         String
  thumbnailUrl        String
  status              Status       @default(ONGOING)
  latestChapterNumber Int
  addedByUserId       User?        @relation(fields: [userId], references: [id])
  userId              Int
  createdAt           DateTime
  reviews             Review[]
  tags                Tag[]
  chapters            Chapter[]
  shelfEntry          ShelfEntry[]
}

enum Status {
  ONGOING
  HIATUS
  COMPLETED
}
