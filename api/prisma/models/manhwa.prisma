model Manhwa {
  id                  Int          @id @default(autoincrement())
  title               String
  description         String
  thumbnailUrl        String
  status              Status       @default(ONGOING)
  latestChapterNumber Int
  addedBy             User?        @relation(fields: [addedByUserId], references: [id])
  addedByUserId       Int?
  createdAt           DateTime     @default(now())

  reviews    Review[]
  tags       Tag[]
  chapters   Chapter[]
  shelfEntry ShelfEntry[]
}

enum Status {
  ONGOING
  HIATUS
  COMPLETED
}
